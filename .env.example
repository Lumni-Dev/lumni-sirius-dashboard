# --- Banco de dados (Postgres do engine, somente leitura) ---
# Na VPS aponte para o Postgres do engine. O dashboard so executa SELECT.
# Recomendado: criar um usuario Postgres somente-leitura e usar aqui.
DATABASE_URL=postgresql://usuario:senha@host:5432/sirius

# "require" quando o Postgres exigir SSL (conexao remota). Vazio/omisso para local.
DATABASE_SSL=require

# --- Autenticacao (NextAuth + Google) ---
# URL publica onde o dashboard roda.
NEXTAUTH_URL=https://dashboard.lumni.dev.br

# Segredo para assinar a sessao (gere com: openssl rand -base64 32).
NEXTAUTH_SECRET=

# Cliente OAuth do tipo "Aplicativo Web" no Google Cloud.
# Redirect URI autorizado: https://dashboard.lumni.dev.br/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
