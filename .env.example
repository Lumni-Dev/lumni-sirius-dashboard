# --- Engine (fonte dos dados, somente leitura via HTTPS) ---
# O dashboard le as metricas do engine, que ja tem acesso ao Postgres da VPS.
# Nada de expor o Postgres: o engine ja e publico e protege /engine_* por token.
ENGINE_URL=https://engine.lumni.dev.br
# Mesmo valor de SIRIUS_ENGINE_TOKEN configurado no engine.
ENGINE_TOKEN=

# --- Autenticacao (NextAuth + Google) ---
# URL publica onde o dashboard roda.
NEXTAUTH_URL=https://dashboard.lumni.dev.br

# Segredo para assinar a sessao (gere com: openssl rand -base64 32).
NEXTAUTH_SECRET=

# Cliente OAuth do tipo "Aplicativo Web" no Google Cloud.
# Redirect URI autorizado: https://dashboard.lumni.dev.br/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Link de compartilhamento (opcional) ---
# Segredo para assinar os links publicos de 1 hora (gere com: openssl rand -base64 32).
# Se vazio, o NEXTAUTH_SECRET e' reutilizado para assinar.
SHARE_LINK_SECRET=
