# --- Banco de dados (Postgres do engine, somente leitura) ---
# Na VPS aponte para o Postgres local do engine. O dashboard so executa SELECT.
# Recomendado: criar um usuario Postgres somente-leitura e usar aqui.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/sirius

# "require" quando o Postgres exigir SSL (conexao remota). Vazio/omisso para local.
DATABASE_SSL=

# --- Autenticacao (NextAuth + Google) ---
# URL publica onde o dashboard vai rodar.
NEXTAUTH_URL=https://dashboard.seu-dominio.com

# Segredo para assinar a sessao (gere com: openssl rand -base64 32).
NEXTAUTH_SECRET=

# Credenciais de um cliente OAuth do tipo "Aplicativo Web" no Google Cloud.
# Redirect URI autorizado: https://dashboard.seu-dominio.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
